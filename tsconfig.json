{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "screeps"],
    "rootDir": "./src",
    "outDir": "dist/",
    "strict": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      { "transform": "@bitpatty/ts-transformer-log-position" }
    ]
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "src/**/*.ts"
  ]
}